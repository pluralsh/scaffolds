{
  "server": {
    "host": "0.0.0.0",
    "port": 9998,
    "endpoints": ["tika", "rmeta", "meta", "detect", "version"],
    "allowPipes": false,
    "allowPerRequestConfig": false,
    "maxRequestSizeBytes": 10485760
  },
  "pipes": {
    "numClients": 1,
    "useSharedServer": false,
    "forkedJvmArgs": ["-Xms64m", "-Xmx768m"],
    "maxWaitForClientMillis": 1000,
    "socketTimeoutMillis": 120000,
    "maxInlineBytes": 1048576,
    "maxIpcPayloadBytes": 8388608
  },
  "parse-context": {
    "timeout-limits": {
      "totalTaskTimeoutMillis": 60000,
      "progressTimeoutMillis": 15000
    },
    "output-limits": {
      "writeLimit": 1000000,
      "throwOnWriteLimit": true
    },
    "embedded-limits": {
      "maxCount": 100
    }
  },
  "parsers": [{"default-parser": {}}]
}
