{% assign azureProvisioner = context.azureProvisioner | default: 'nap' %}
{% if context.cloud == 'aws' and context.awsProvisioner == 'karpenter' %}
{% assign instanceTypes = context.instanceTypes | split: "," %}
apiVersion: karpenter.k8s.aws/v1
kind: EC2NodeClass
metadata:
  name: {{ context.pool }}
spec:
  amiSelectorTerms:
  - alias: al2023@latest
{% raw %}
  role: {{ imports[configuration.stackName].node_role_name }}
  subnetSelectorTerms:
{% assign subnets = imports[configuration.stackName].subnet_ids | split: "," %}
{% for subnet in subnets %}
  - id: {{ subnet }}
{% endfor %}
  securityGroupSelectorTerms:
{% assign securityGroups = imports[configuration.stackName].node_security_group_ids | split: "," %}
{% for securityGroup in securityGroups %}
  - id: {{ securityGroup }}
{% endfor %}
{% endraw %}
  # Lets the pool run microvm sandboxes as well as gvisor; it needs instance types that support it.
  cpuOptions:
    nestedVirtualization: enabled
  metadataOptions:
    httpEndpoint: enabled
    httpTokens: required
    httpPutResponseHopLimit: 1
  blockDeviceMappings:
  - deviceName: /dev/xvda
    ebs:
      volumeSize: {{ context.bootDiskSize }}Gi
      volumeType: gp3
      encrypted: true
      deleteOnTermination: true
{% if context.diskMode == 'network' %}
  - deviceName: /dev/xvdb
    ebs:
      volumeSize: {{ context.dataDiskSize }}Gi
      volumeType: gp3
      iops: 6000
      throughput: 500
      encrypted: true
      deleteOnTermination: true
{% endif %}
  tags:
    plural.sh/devbox-pool: {{ context.pool }}
---
apiVersion: karpenter.sh/v1
kind: NodePool
metadata:
  name: {{ context.pool }}
spec:
  template:
    metadata:
      labels:
        plural.sh/devbox-pool: {{ context.pool }}
    spec:
      nodeClassRef:
        group: karpenter.k8s.aws
        kind: EC2NodeClass
        name: {{ context.pool }}
      taints:
      - key: ate.dev/sandboxClass
        value: {{ context.sandboxClass }}
        effect: NoSchedule
      startupTaints:
      - key: plural.sh/devbox-disk
        value: pending
        effect: NoSchedule
      requirements:
      - key: kubernetes.io/arch
        operator: In
        values: ["amd64"]
      - key: karpenter.sh/capacity-type
        operator: In
        values: ["on-demand"]
      - key: node.kubernetes.io/instance-type
        operator: In
        values:
{% for type in instanceTypes %}
        - {{ type | strip }}
{% endfor %}
      # Sandboxes are stateful between snapshots: never expire nodes, and give atelet time to suspend
      # actors when a node is drained.
      expireAfter: Never
      terminationGracePeriod: 1h
  disruption:
    consolidationPolicy: WhenEmpty
    consolidateAfter: 15m
    budgets:
    - nodes: "10%"
  limits:
    cpu: "{{ context.maxCpu }}"
---
# Karpenter only launches a node for a pod whose requests the instance type covers, and ate.dev/kvm (which microvm
# workers request) only appears once atelet's device plugin runs on the node, so an empty pool would never scale up
# for one. The count is the one atelet advertises; it is a placeholder, not a limit. Needs Karpenter's NodeOverlay
# feature gate.
apiVersion: karpenter.sh/v1alpha1
kind: NodeOverlay
metadata:
  name: {{ context.pool }}-kvm
spec:
  requirements:
  - key: karpenter.sh/nodepool
    operator: In
    values: ["{{ context.pool }}"]
  capacity:
    ate.dev/kvm: "4096"
{% elsif context.cloud == 'azure' and azureProvisioner == 'nap' %}
{% assign instanceTypes = context.instanceTypes | split: "," %}
# AKS node auto-provisioning (managed Karpenter)
apiVersion: karpenter.azure.com/v1beta1
kind: AKSNodeClass
metadata:
  name: {{ context.pool }}
spec:
  imageFamily: Ubuntu
  osDiskSizeGB: {{ context.bootDiskSize }}
  osDiskType: Managed
  # Azure has no nested virtualization switch: the VM size brings it (Dv5, Ev5, Lsv3) and Trusted Launch takes it
  # away. With it the pool can run microvm sandboxes as well as gvisor.
  security:
    trustedLaunch:
      secureBoot: false
      vtpm: false
  tags:
    plural-devbox-pool: {{ context.pool }}
---
apiVersion: karpenter.sh/v1
kind: NodePool
metadata:
  name: {{ context.pool }}
spec:
  template:
    metadata:
      labels:
        plural.sh/devbox-pool: {{ context.pool }}
{% raw %}
{% if imports[configuration.stackName].network_dataplane == "cilium" %}
        # lets NAP account for the Cilium agent on each node
        kubernetes.azure.com/ebpf-dataplane: cilium
{% endif %}
{% endraw %}
    spec:
      nodeClassRef:
        group: karpenter.azure.com
        kind: AKSNodeClass
        name: {{ context.pool }}
      taints:
      - key: ate.dev/sandboxClass
        value: {{ context.sandboxClass }}
        effect: NoSchedule
      startupTaints:
      - key: plural.sh/devbox-disk
        value: pending
        effect: NoSchedule
{% raw %}
{% if imports[configuration.stackName].network_dataplane == "cilium" %}
      - key: node.cilium.io/agent-not-ready
        value: "true"
        effect: NoExecute
{% endif %}
{% endraw %}
      requirements:
      - key: kubernetes.io/arch
        operator: In
        values: ["amd64"]
      - key: karpenter.sh/capacity-type
        operator: In
        values: ["on-demand"]
      - key: node.kubernetes.io/instance-type
        operator: In
        values:
{% for type in instanceTypes %}
        - {{ type | strip }}
{% endfor %}
      # Sandboxes are stateful between snapshots: never expire nodes, and give atelet time to suspend
      # actors when a node is drained.
      expireAfter: Never
      terminationGracePeriod: 1h
  disruption:
    consolidationPolicy: WhenEmpty
    consolidateAfter: 15m
    budgets:
    - nodes: "10%"
  limits:
    cpu: "{{ context.maxCpu }}"
{% endif %}
