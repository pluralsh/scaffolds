{% if context.cloud == 'aws' and context.awsProvisioner == 'karpenter' %}
{% assign instanceTypes = context.instanceTypes | split: "," %}
apiVersion: karpenter.k8s.aws/v1
kind: EC2NodeClass
metadata:
  name: {{ context.pool }}
spec:
  amiSelectorTerms:
  - alias: al2023@latest
{% raw %}
  role: {{ imports[configuration.stackName].node_role_name }}
  subnetSelectorTerms:
{% assign subnets = imports[configuration.stackName].subnet_ids | split: "," %}
{% for subnet in subnets %}
  - id: {{ subnet }}
{% endfor %}
  securityGroupSelectorTerms:
  - id: {{ imports[configuration.stackName].node_security_group_id }}
{% endraw %}
{% if context.sandboxClass == 'microvm' %}
  cpuOptions:
    nestedVirtualization: enabled
{% endif %}
  metadataOptions:
    httpEndpoint: enabled
    httpTokens: required
    httpPutResponseHopLimit: 1
  blockDeviceMappings:
  - deviceName: /dev/xvda
    ebs:
      volumeSize: {{ context.bootDiskSize }}Gi
      volumeType: gp3
      encrypted: true
      deleteOnTermination: true
{% if context.diskMode == 'network' %}
  - deviceName: /dev/xvdb
    ebs:
      volumeSize: {{ context.dataDiskSize }}Gi
      volumeType: gp3
      iops: 6000
      throughput: 500
      encrypted: true
      deleteOnTermination: true
{% endif %}
  tags:
    plural.sh/devbox-pool: {{ context.pool }}
---
apiVersion: karpenter.sh/v1
kind: NodePool
metadata:
  name: {{ context.pool }}
spec:
  template:
    metadata:
      labels:
        plural.sh/devbox-pool: {{ context.pool }}
    spec:
      nodeClassRef:
        group: karpenter.k8s.aws
        kind: EC2NodeClass
        name: {{ context.pool }}
      taints:
      - key: ate.dev/sandboxClass
        value: {{ context.sandboxClass }}
        effect: NoSchedule
      startupTaints:
      - key: plural.sh/devbox-disk
        value: pending
        effect: NoSchedule
      requirements:
      - key: kubernetes.io/arch
        operator: In
        values: ["amd64"]
      - key: karpenter.sh/capacity-type
        operator: In
        values: ["on-demand"]
      - key: node.kubernetes.io/instance-type
        operator: In
        values:
{% for type in instanceTypes %}
        - {{ type | strip }}
{% endfor %}
      # Sandboxes are stateful between snapshots: never expire nodes, and give atelet time to suspend
      # actors when a node is drained.
      expireAfter: Never
      terminationGracePeriod: 1h
  disruption:
    consolidationPolicy: WhenEmpty
    consolidateAfter: 15m
    budgets:
    - nodes: "10%"
  limits:
    cpu: "{{ context.maxCpu }}"
{% endif %}
