{% assign karpenter = false %}
{% if context.cloud == 'aws' and context.awsProvisioner == 'karpenter' and context.installKarpenter %}
{% assign karpenter = true %}
{% endif %}
{% if context.diskMode == 'local' %}
{% case context.cloud %}
{% when 'aws' %}{% assign diskModel = 'Instance Storage' %}
{% when 'gcp' %}{% assign diskModel = '^nvme_card$' %}
{% when 'azure' %}{% assign diskModel = 'NVMe Direct Disk' %}
{% endcase %}
{% elsif context.cloud == 'aws' %}
{% assign diskModel = 'Elastic Block Store' %}
{% else %}
{% assign diskModel = '' %}
{% endif %}
apiVersion: deployments.plural.sh/v1alpha1
kind: InfrastructureStack
metadata:
  name: devbox-nodes-{{ context.cluster }}
  namespace: apps
spec:
{% if context.ai %}
  agentId: {{ context.ai.session.agent_id }}
{% endif %}
  detach: false
  type: TERRAFORM
  approval: true
  manageState: true
  actor: console@plural.sh
  git:
    ref: main
    folder: terraform/apps/devbox-nodes/{{ context.cluster }}
  repositoryRef:
    name: infra
    namespace: infra
  {% if context.cloud == 'azure' %}
  jobSpec:
    namespace: plrl-deploy-operator
    labels:
      azure.workload.identity/use: "true"
    serviceAccount: stacks
  {% endif %}
  clusterRef:
    name: mgmt
    namespace: infra
{% if karpenter %}
---
apiVersion: deployments.plural.sh/v1alpha1
kind: ServiceDeployment
metadata:
  name: karpenter-{{ context.cluster }}
  namespace: apps
spec:
{% if context.ai %}
  agentId: {{ context.ai.session.agent_id }}
{% endif %}
  name: karpenter
  namespace: karpenter
  git:
    folder: helm/devbox-nodes/{{ context.cluster }}
    ref: main
  repositoryRef:
    kind: GitRepository
    name: infra
    namespace: infra
  helm:
    version: "{{ context.karpenterVersion }}"
    chart: karpenter
    release: karpenter
    url: oci://public.ecr.aws/karpenter
    valuesFiles:
    - karpenter.yaml.liquid
  imports:
  - stackRef:
      name: devbox-nodes-{{ context.cluster }}
      namespace: apps
  configuration:
    stackName: devbox-nodes-{{ context.cluster }}
  cluster: {{ context.cluster }}
{% endif %}
---
apiVersion: deployments.plural.sh/v1alpha1
kind: ServiceDeployment
metadata:
  name: devbox-nodes-{{ context.cluster }}
  namespace: apps
spec:
{% if context.ai %}
  agentId: {{ context.ai.session.agent_id }}
{% endif %}
  name: devbox-nodes
  namespace: devbox-nodes
  git:
    folder: services/devbox-nodes/{{ context.cluster }}
    ref: main
  repositoryRef:
    kind: GitRepository
    name: infra
    namespace: infra
{% if karpenter %}
  dependencies:
  - name: karpenter
{% endif %}
  imports:
  - stackRef:
      name: devbox-nodes-{{ context.cluster }}
      namespace: apps
  configuration:
    stackName: devbox-nodes-{{ context.cluster }}
    pool: {{ context.pool }}
    diskModel: "{{ diskModel }}"
    diskPrepImage: {{ context.diskPrepImage }}
  cluster: {{ context.cluster }}
