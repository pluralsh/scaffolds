apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: dns01
spec:
  acme:
    server: https://acme-v02.api.letsencrypt.org/directory
    email: {{ context.email | json }}
    privateKeySecretRef:
      name: dns01-private-key
    solvers:
    - dns01:
{% if context.cloud == 'aws' %}
        route53:
          region: {{ context.region | json }}{% elsif context.cloud == 'azure' %}
        azureDNS:
          hostedZoneName: {{ context.dnsZone | json }}
          resourceGroupName: {{ context.resourceGroupName | json }}
          subscriptionID: {% raw %}{{ cluster.metadata.subscription_id }}{% endraw %}
          managedIdentity:
            clientID: {% raw %}{{ cluster.metadata.iam.cert_manager }}{% endraw %}
          environment: AzurePublicCloud{% elsif context.cloud == 'gcp' %}
        cloudDNS:
          project: {% raw %}{{ cluster.metadata.project }}{% endraw %}{% endif %}
