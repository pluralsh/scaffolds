{% if context.cloud == 'azure' %}
podLabels:
  azure.workload.identity/use: "true"
{% endif %}
installCRDs: true
serviceAccount:
  name: cert-manager
  annotations:
{% if context.cloud == 'aws' %}
{% raw %}    eks.amazonaws.com/role-arn: {{ cluster.metadata.iam.cert_manager }}{% endraw %}{% elsif context.cloud == 'azure' %}
{% raw %}    azure.workload.identity/client-id: {{ cluster.metadata.iam.cert_manager }}{% endraw %}{% elsif context.cloud == 'gcp' %}
{% raw %}    iam.gke.io/gcp-service-account: {{ cluster.metadata.iam.cert_manager }}{% endraw %}{% endif %}
securityContext:
  fsGroup: 1000
  runAsNonRoot: true
