{% if context.cloud == "gcp" %}
provider: google
{% else %}
provider: {{ context.cloud }}
{% endif %}

{% raw %}
txtOwnerId: plrl-{{ cluster.handle }} # templating in the cluster handle, which is unique, to be the external-dns owner id
{% endraw %}
policy: upsert-only

domainFilters:
- {{ context.dnsZone }}

{% if context.cloud == "aws" %}
{% raw %}
serviceAccount:
  annotations:
    eks.amazonaws.com/role-arn: {{ cluster.metadata.iam.external_dns }}{% endraw %}{% elsif context.cloud == "azure" %}
azure:
  secretName: {{ context.azureConfigSecret | json }}
podLabels:
  azure.workload.identity/use: "true"
{% raw %}
serviceAccount:
  annotations:
    azure.workload.identity/client-id: {{ cluster.metadata.iam.external_dns }}{% endraw %}{% elsif context.cloud == "gcp" %}
{% raw %}
serviceAccount:
  annotations:
    iam.gke.io/gcp-service-account: {{ cluster.metadata.iam.external_dns }}{% endraw %}{% endif %}
