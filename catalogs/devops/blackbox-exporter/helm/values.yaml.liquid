automountServiceAccountToken: false

replicas: 1

service:
  type: ClusterIP
  port: 9115

ingress:
  enabled: false

route:
  main:
    enabled: false

securityContext:
  runAsUser: 1000
  runAsGroup: 1000
  runAsNonRoot: true
  readOnlyRootFilesystem: true
  allowPrivilegeEscalation: false
  capabilities:
    drop:
    - ALL

resources:
  requests:
    cpu: 10m
    memory: 32Mi
  limits:
    cpu: 100m
    memory: 128Mi

config:
  modules:
    http_2xx:
      prober: http
      timeout: 5s
      http:
        valid_http_versions:
        - HTTP/1.1
        - HTTP/2.0
        follow_redirects: true
        preferred_ip_protocol: ip4

serviceMonitor:
  enabled: false
  selfMonitor:
    enabled: false
