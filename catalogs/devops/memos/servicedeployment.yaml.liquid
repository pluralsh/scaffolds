apiVersion: deployments.plural.sh/v1alpha1
kind: ServiceDeployment
metadata:
  name: memos-{{ context.cluster }}
  namespace: apps
spec:
{% if context.ai %}
  agentId: {{ context.ai.session.agent_id }}
{% endif %}
  name: memos
  namespace: memos
  git:
    ref: main
    folder: kubernetes/memos/{{ context.cluster }}
  repositoryRef:
    kind: GitRepository
    name: infra
    namespace: infra
  cluster: {{ context.cluster | quote }}
