apiVersion: deployments.plural.sh/v1alpha1
kind: GlobalService
metadata:
  name: alloy-operator
  namespace: apps
spec:
  mgmt: true
  cascade:
    detach: true
  template:
    name: alloy-operator
    namespace: alloy
    dependencies: []
    helm:
      version: "0.8.0"
      chart: alloy-operator
      url: https://grafana.github.io/helm-charts
      values:
        crds:
          deployAlloyCRD: true
---
apiVersion: deployments.plural.sh/v1alpha1
kind: GlobalService
metadata:
  name: alloy
  namespace: apps
spec:
  mgmt: true
  template:
    name: alloy
    namespace: alloy
    dependencies:
    - name: alloy-operator
    git:
      ref: main
      folder: helm/telemetry-agent
    repositoryRef:
      kind: GitRepository
      name: infra
      namespace: infra
    # Basic auth credentials generated by the plural-telemetry catalog on mgmt.
    configurationRef:
      name: telemetry-auth-{{ context.telemetryCluster }}
      namespace: apps
    helm:
      version: "4.5.3"
      chart: k8s-monitoring
      url: https://grafana.github.io/helm-charts
      valuesFiles:
      - alloy.yaml.liquid
