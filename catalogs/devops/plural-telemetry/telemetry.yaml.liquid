apiVersion: deployments.plural.sh/v1alpha1
kind: InfrastructureStack
metadata:
  name: telemetry-{{ context.cluster }}
  namespace: apps
spec:
{% if context.ai %}
  agentId: {{ context.ai.session.agent_id }}
{% endif %}
  detach: false
  type: TERRAFORM
  approval: true
  manageState: true
  actor: console@plural.sh
  git:
    ref: main
    folder: terraform/apps/telemetry/{{ context.cluster }}
  repositoryRef:
    name: infra
    namespace: infra
  {% if context.cloud == 'azure' %}
  jobSpec:
    namespace: plrl-deploy-operator
    labels:
      azure.workload.identity/use: "true"
    serviceAccount: stacks
  {% endif %}
  clusterRef:
    name: mgmt
    namespace: infra
---
# Basic auth password shared by all three products. It is generated by the
# Console controller on mgmt, so it is never committed to git or stored in
# terraform state. The stack service reads it through configurationRef and the
# chart creates the secret on the target cluster, which may not be mgmt.
apiVersion: deployments.plural.sh/v1alpha1
kind: GeneratedSecret
metadata:
  name: telemetry-auth-{{ context.cluster }}
  namespace: apps
spec:
  template:
    username: plrl
    password: "{% raw %}{{ 32 | randAlphaNum }}{% endraw %}"
  destinations:
  - name: telemetry-auth-{{ context.cluster }}
    namespace: apps
---
apiVersion: deployments.plural.sh/v1alpha1
kind: ServiceDeployment
metadata:
  name: telemetry-operator-{{ context.cluster }}
  namespace: apps
spec:
{% if context.ai %}
  agentId: {{ context.ai.session.agent_id }}
{% endif %}
  name: telemetry-operator
  namespace: plrl-telemetry
  helm:
    version: "0.1.42"
    chart: telemetry-operator
    release: telemetry-operator
    url: oci://ghcr.io/pluralsh/charts
  cluster: {{ context.cluster }}
---
apiVersion: deployments.plural.sh/v1alpha1
kind: ServiceDeployment
metadata:
  name: telemetry-stack-{{ context.cluster }}
  namespace: apps
spec:
{% if context.ai %}
  agentId: {{ context.ai.session.agent_id }}
{% endif %}
  name: telemetry-stack
  namespace: plrl-telemetry
  git:
    folder: helm/telemetry/{{ context.cluster }}
    ref: main
  repositoryRef:
    kind: GitRepository
    name: infra
    namespace: infra
  helm:
    version: "0.1.25"
    chart: telemetry-stack
    release: telemetry-stack
    url: oci://ghcr.io/pluralsh/charts
    valuesFiles:
    - telemetry.yaml.liquid
  dependencies:
  - name: telemetry-operator
  configurationRef:
    name: telemetry-auth-{{ context.cluster }}
    namespace: apps
  imports:
  - stackRef:
      name: telemetry-{{ context.cluster }}
      namespace: apps
  configuration:
    cluster: "{{ context.cluster }}"
    cloud: "{{ context.cloud }}"
    stackName: telemetry-{{ context.cluster }}
    hostname: "{{ context.hostname }}"
    ingressClass: "{{ context.ingressClass | default: "nginx" }}"
    clusterIssuer: "{{ context.clusterIssuer | default: "letsencrypt-prod" }}"
  cluster: {{ context.cluster }}
{% if context.monitoring == true or context.monitoring == "true" %}
---
# Needs the Prometheus operator CRDs (monitoring.coreos.com/v1) on the target
# cluster, and something that scrapes ServiceMonitors.
apiVersion: deployments.plural.sh/v1alpha1
kind: ServiceDeployment
metadata:
  name: telemetry-monitoring-{{ context.cluster }}
  namespace: apps
spec:
{% if context.ai %}
  agentId: {{ context.ai.session.agent_id }}
{% endif %}
  name: telemetry-monitoring
  namespace: plrl-telemetry
  git:
    folder: monitoring/telemetry/{{ context.cluster }}
    ref: main
  repositoryRef:
    kind: GitRepository
    name: infra
    namespace: infra
  dependencies:
  - name: telemetry-stack
  cluster: {{ context.cluster }}
{% endif %}
