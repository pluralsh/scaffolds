apiVersion: deployments.plural.sh/v1alpha1
kind: InfrastructureStack
metadata:
  name: telemetry-{{ context.cluster }}
  namespace: apps
spec:
{% if context.ai %}
  agentId: {{ context.ai.session.agent_id }}
{% endif %}
  detach: false
  type: TERRAFORM
  approval: true
  manageState: true
  actor: console@plural.sh
  git:
    ref: main
    folder: terraform/apps/telemetry/{{ context.cluster }}
  repositoryRef:
    name: infra
    namespace: infra
  {% if context.cloud == 'azure' %}
  jobSpec:
    namespace: plrl-deploy-operator
    labels:
      azure.workload.identity/use: "true"
    serviceAccount: stacks
  {% endif %}
  clusterRef:
    name: mgmt
    namespace: infra
---
# Basic auth password shared by all three products. It is generated by the
# Console controller on mgmt, so it is never committed to git or stored in
# terraform state. The stack service reads it through configurationRef and the
# chart creates the secret on the target cluster, which may not be mgmt.
apiVersion: deployments.plural.sh/v1alpha1
kind: GeneratedSecret
metadata:
  name: telemetry-auth-{{ context.cluster }}
  namespace: apps
spec:
  template:
    username: plrl
    password: "{% raw %}{{ 32 | randAlphaNum }}{% endraw %}"
  destinations:
  - name: telemetry-auth-{{ context.cluster }}
    namespace: apps
  # The Console reads this one: the global DeploymentSettings resolve secret
  # references in their own namespace, plrl-deploy-operator. The name is per
  # instance so it cannot collide with a secret another GeneratedSecret owns.
  - name: telemetry-auth-{{ context.cluster }}
    namespace: plrl-deploy-operator
---
apiVersion: deployments.plural.sh/v1alpha1
kind: ServiceDeployment
metadata:
  name: telemetry-operator-{{ context.cluster }}
  namespace: apps
spec:
{% if context.ai %}
  agentId: {{ context.ai.session.agent_id }}
{% endif %}
  name: telemetry-operator
  namespace: plrl-telemetry
  helm:
    version: "0.1.42"
    chart: telemetry-operator
    release: telemetry-operator
    url: oci://ghcr.io/pluralsh/charts
  cluster: {{ context.cluster }}
---
apiVersion: deployments.plural.sh/v1alpha1
kind: ServiceDeployment
metadata:
  name: telemetry-{{ context.cluster }}
  namespace: apps
spec:
{% if context.ai %}
  agentId: {{ context.ai.session.agent_id }}
{% endif %}
  name: telemetry
  namespace: plrl-telemetry
  git:
    folder: helm/telemetry/{{ context.cluster }}
    ref: main
  repositoryRef:
    kind: GitRepository
    name: infra
    namespace: infra
  helm:
    version: "0.1.25"
    chart: telemetry-stack
    release: telemetry
    url: oci://ghcr.io/pluralsh/charts
    valuesFiles:
    - telemetry.yaml.liquid
  dependencies:
  - name: telemetry-operator
  configurationRef:
    name: telemetry-auth-{{ context.cluster }}
    namespace: apps
  imports:
  - stackRef:
      name: telemetry-{{ context.cluster }}
      namespace: apps
  configuration:
    cluster: "{{ context.cluster }}"
    cloud: "{{ context.cloud }}"
    stackName: telemetry-{{ context.cluster }}
    hostname: "{{ context.hostname }}"
    ingressClass: "{{ context.ingressClass | default: "nginx" }}"
    clusterIssuer: "{{ context.clusterIssuer | default: "letsencrypt-prod" }}"
  cluster: {{ context.cluster }}
{% unless context.agent == false or context.agent == "false" %}
---
# Grafana Alloy on every cluster, including mgmt, shipping metrics, logs and
# traces to the Telemetry ingress above. It reuses the generated credentials
# through configurationRef, so no password is stored in git.
apiVersion: deployments.plural.sh/v1alpha1
kind: GlobalService
metadata:
  name: telemetry-agent-operator
  namespace: apps
spec:
  mgmt: true
  cascade:
    detach: true
  template:
    name: telemetry-agent-operator
    namespace: plrl-telemetry-agent
    dependencies: []
    helm:
      version: "0.8.0"
      chart: alloy-operator
      url: https://grafana.github.io/helm-charts
      values:
        crds:
          deployAlloyCRD: true
---
apiVersion: deployments.plural.sh/v1alpha1
kind: GlobalService
metadata:
  name: telemetry-agent
  namespace: apps
spec:
  mgmt: true
  template:
    name: telemetry-agent
    namespace: plrl-telemetry-agent
    dependencies:
    - name: telemetry-agent-operator
    git:
      ref: main
      folder: helm/telemetry/{{ context.cluster }}
    repositoryRef:
      kind: GitRepository
      name: infra
      namespace: infra
    configurationRef:
      name: telemetry-auth-{{ context.cluster }}
      namespace: apps
    helm:
      version: "4.5.3"
      chart: k8s-monitoring
      url: https://grafana.github.io/helm-charts
      valuesFiles:
      - alloy.yaml.liquid
{% endunless %}
