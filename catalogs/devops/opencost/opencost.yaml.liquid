opencost:
  exporter:
    defaultClusterId: {% raw %}{{ cluster.handle }}{% endraw %}
    extraEnv:
      KUBECOST_SCRAPE_INTERVAL: 30s
      PROM_CLUSTER_ID_LABEL: cluster
  prometheus:
    external:
      enabled: true
      url: {{ context.prometheusUrl | json }}
    internal:
      enabled: false
{% if context.auth == 'existing_secret' %}
    existingSecretName: {{ context.secretName | json }}
    username_key: username
    password_key: password
{% else %}
    username: {{ context.username | json }}
    password: {{ context.password | json }}
    username_key: username
    password_key: password
{% endif %}
  metrics:
    serviceMonitor:
      enabled: true
