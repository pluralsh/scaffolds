# Local development and end-to-end testing of the GCP functions, see README.md.
#
# Every variable can be set from the environment or on the command line, e.g.
# `ZONE=europe-central2-b just fixtures` or `just zone=europe-central2-b fixtures`.

# Variables are only evaluated when a recipe uses them, so `just test` doesn't call gcloud.
set lazy

project := env("PROJECT", `gcloud config get project 2>/dev/null`)
zone := env("ZONE", "europe-central2-a")
port := env("PORT", "8080")
allow_skip_snapshot := env("ALLOW_SKIP_SNAPSHOT", "false")

# Prefix of every resource the e2e recipes create.
prefix := env("P", "e2e-vd")
vm := prefix + "-vm"
disks := "ok att det nok8s nopv skip other"

sa := prefix + "-fn"
sa_email := sa + "@" + project + ".iam.gserviceaccount.com"
# Custom role IDs can't be reused for 7 days after deletion.
role := env("ROLE", "e2eVolumeDelete")
# Keep in sync with `permissions` of volume-delete in
# catalogs/infra/cloud-functions/terraform/gcp/locals.tf.
volume_delete_permissions := "compute.disks.get,compute.disks.delete,compute.disks.createSnapshot,compute.snapshots.create,compute.snapshots.list,compute.snapshots.setLabels"

# List the recipes.
default:
    @just --list --unsorted

# --- Development ---

# Format check, vet, lint and unit tests.
check: fmt-check vet lint test

fmt-check:
    #!/usr/bin/env bash
    set -euo pipefail
    unformatted="$(gofmt -l .)"
    if [ -n "$unformatted" ]; then echo "gofmt needed:"; echo "$unformatted"; exit 1; fi

vet:
    go vet ./...

lint:
    golangci-lint run ./...

# Unit tests, e.g. `just test -run TestPlan ./internal/volumedelete`.
test *args="./...":
    go test -race {{ args }}

# Serve a function locally on the port, acting in the project as the ADC identity.
serve target="VolumeDelete":
    FUNCTION_TARGET={{ quote(target) }} \
    GOOGLE_CLOUD_PROJECT={{ quote(project) }} \
    ALLOW_SKIP_SNAPSHOT={{ quote(allow_skip_snapshot) }} \
    PORT={{ quote(port) }} \
    go run ./cmd

# POST a raw JSON body to the local function and print the status and response.
invoke body:
    #!/usr/bin/env bash
    set -euo pipefail
    out="$(curl -s -w '\n%{http_code}' -X POST -H 'Content-Type: application/json' \
      --data-binary {{ quote(body) }} 'http://localhost:{{ port }}/')"
    echo "HTTP ${out##*$'\n'}"
    resp="${out%$'\n'*}"
    if [ -n "$resp" ]; then jq . <<<"$resp" 2>/dev/null || echo "$resp"; fi

# Plan a VolumeDelete. snapshot is empty (omitted), true or false.
plan disk pv snapshot="": (_volume-delete "plan" disk pv snapshot)

# Execute a VolumeDelete. snapshot is empty (omitted), true or false.
execute disk pv snapshot="": (_volume-delete "execute" disk pv snapshot)

_volume-delete action disk pv snapshot:
    #!/usr/bin/env bash
    set -euo pipefail
    body="$(jq -cn --arg action {{ quote(action) }} --arg zone {{ quote(zone) }} \
      --arg disk {{ quote(disk) }} --arg pv {{ quote(pv) }} \
      '{action: $action, zone: $zone, disk: $disk, pvName: $pv}')"
    if [ -n {{ quote(snapshot) }} ]; then
      body="$(jq -c --argjson snapshot {{ quote(snapshot) }} '. + {snapshot: $snapshot}' <<<"$body")"
    fi
    echo "> $body"
    just port={{ quote(port) }} invoke "$body"

# --- GCP project ---

# Enable the APIs the function and the e2e recipes use.
apis:
    gcloud services enable compute.googleapis.com iam.googleapis.com --project {{ quote(project) }}

# Use your own account as ADC. Restart `just serve` afterwards.
login-user:
    gcloud auth application-default login
    gcloud auth application-default set-quota-project {{ quote(project) }}

# Use the minimal service account as ADC (see sa-create). Restart `just serve` afterwards.
login-sa:
    gcloud auth application-default login --impersonate-service-account {{ quote(sa_email) }}

# Create the function's service account with the same custom role terraform grants.
sa-create:
    gcloud iam service-accounts create {{ quote(sa) }} --project {{ quote(project) }} \
      --display-name "VolumeDelete local e2e"
    gcloud iam roles create {{ quote(role) }} --project {{ quote(project) }} --stage GA \
      --title "VolumeDelete local e2e" --permissions {{ quote(volume_delete_permissions) }}
    gcloud projects add-iam-policy-binding {{ quote(project) }} --condition None \
      --member "serviceAccount:{{ sa_email }}" --role "projects/{{ project }}/roles/{{ role }}"
    gcloud iam service-accounts add-iam-policy-binding {{ quote(sa_email) }} --project {{ quote(project) }} \
      --member "user:$(gcloud config get account)" --role roles/iam.serviceAccountTokenCreator

# Remove a permission from the custom role, e.g. for test cases G3 and G4.
role-remove permission:
    gcloud iam roles update {{ quote(role) }} --project {{ quote(project) }} --remove-permissions {{ quote(permission) }}

# Add a permission back to the custom role.
role-add permission:
    gcloud iam roles update {{ quote(role) }} --project {{ quote(project) }} --add-permissions {{ quote(permission) }}

# Delete the service account and its custom role.
sa-delete:
    -gcloud projects remove-iam-policy-binding {{ quote(project) }} --condition None \
      --member "serviceAccount:{{ sa_email }}" --role "projects/{{ project }}/roles/{{ role }}"
    -gcloud iam roles delete {{ quote(role) }} --project {{ quote(project) }}
    -gcloud iam service-accounts delete {{ quote(sa_email) }} --project {{ quote(project) }} --quiet

# --- E2E fixtures ---

# Create the test disks and VM, and attach the "att" disk to the VM.
fixtures:
    #!/usr/bin/env bash
    set -euo pipefail
    # The CSI metadata the GCE PD CSI driver writes to the description of the disks it creates.
    csi() {
      jq -cn --arg pv "$1" '{"kubernetes.io/created-for/pv/name": $pv,
        "kubernetes.io/created-for/pvc/name": "data", "kubernetes.io/created-for/pvc/namespace": "e2e"}'
    }
    mkdisk() {
      gcloud compute disks create "{{ prefix }}-$1" --project {{ quote(project) }} --zone {{ quote(zone) }} \
        --size 10GB --type pd-standard ${2:+--description "$2"} --quiet
    }
    mkdisk ok    "$(csi pvc-e2e-ok)"
    mkdisk att   "$(csi pvc-e2e-att)"
    mkdisk det   "$(csi pvc-e2e-det)"
    mkdisk nok8s
    mkdisk nopv  '{"kubernetes.io/created-for/pvc/name":"data"}'
    mkdisk skip  "$(csi pvc-e2e-skip)"
    mkdisk other "$(csi pvc-e2e-other)"
    gcloud compute instances create {{ quote(vm) }} --project {{ quote(project) }} --zone {{ quote(zone) }} \
      --machine-type e2-micro --image-family debian-12 --image-project debian-cloud --quiet
    gcloud compute instances attach-disk {{ quote(vm) }} --disk "{{ prefix }}-att" --project {{ quote(project) }} --zone {{ quote(zone) }}

# Recreate one disk with CSI metadata for pv, e.g. `just recreate e2e-vd-ok pvc-e2e-ok`.
recreate disk pv:
    gcloud compute disks create {{ quote(disk) }} --project {{ quote(project) }} --zone {{ quote(zone) }} \
      --size 10GB --type pd-standard --quiet \
      --description "$(jq -cn --arg pv {{ quote(pv) }} '{"kubernetes.io/created-for/pv/name": $pv, "kubernetes.io/created-for/pvc/name": "data", "kubernetes.io/created-for/pvc/namespace": "e2e"}')"

# Attach a disk to the test VM.
attach disk:
    gcloud compute instances attach-disk {{ quote(vm) }} --disk {{ quote(disk) }} --project {{ quote(project) }} --zone {{ quote(zone) }}

# Detach a disk from the test VM.
detach disk:
    gcloud compute instances detach-disk {{ quote(vm) }} --disk {{ quote(disk) }} --project {{ quote(project) }} --zone {{ quote(zone) }}

# Show a disk's ID, status, users, last detach time and description.
disk disk:
    gcloud compute disks describe {{ quote(disk) }} --project {{ quote(project) }} --zone {{ quote(zone) }} \
      --format 'yaml(id,status,users,lastDetachTimestamp,description)'

# List the pre-deletion snapshots labelled with a disk's ID.
snapshots disk:
    gcloud compute snapshots list --project {{ quote(project) }} \
      --filter "labels.plural-sh-volume-delete=$(gcloud compute disks describe {{ quote(disk) }} --project {{ quote(project) }} --zone {{ quote(zone) }} --format 'value(id)')" \
      --format 'table(name,status,sourceDiskId,creationTimestamp)'

# List every resource the e2e recipes created.
resources:
    gcloud compute disks list --project {{ quote(project) }} --filter "name~^{{ prefix }}-" --format 'table(name,zone.basename(),status,users.basename())'
    gcloud compute snapshots list --project {{ quote(project) }} --filter "name~^{{ prefix }}-" --format 'table(name,status,sourceDisk.basename(),creationTimestamp)'
    gcloud compute instances list --project {{ quote(project) }} --filter "name~^{{ prefix }}-" --format 'table(name,zone.basename(),status)'

# Delete the test VM, disks and snapshots. Keeps the service account, see sa-delete.
cleanup:
    #!/usr/bin/env bash
    set -uo pipefail
    gcloud compute instances delete {{ quote(vm) }} --project {{ quote(project) }} --zone {{ quote(zone) }} --quiet
    for d in {{ disks }}; do
      gcloud compute disks delete "{{ prefix }}-$d" --project {{ quote(project) }} --zone {{ quote(zone) }} --quiet
    done
    gcloud compute snapshots list --project {{ quote(project) }} --filter "name~^{{ prefix }}-" --format 'value(name)' \
      | xargs -r gcloud compute snapshots delete --project {{ quote(project) }} --quiet
