dist := "dist"
musl_target := "x86_64-unknown-linux-musl"

# Functions are grouped by cloud through their bin name suffix, e.g. volume-delete-aws.
aws_bins := `ls bins | grep -- '-aws$' | tr '\n' ' '`
azure_bins := `ls bins | grep -- '-azure$' | tr '\n' ' '`
gcp_bins := `ls bins | grep -- '-gcp$' | tr '\n' ' '`

# Format check, lint and unit tests.
check:
    cargo fmt --check
    cargo clippy --all-targets -- -D warnings
    cargo test

# Build every function.
build: build-aws build-musl

# Build AWS functions as arm64 Lambda zips under target/lambda/<bin>/bootstrap.zip.
build-aws:
    cargo lambda build --release --arm64 --output-format zip $(printf -- '--bin %s ' {{aws_bins}})

# The binaries run in Azure Functions custom handlers and on the Cloud Run OS-only base image.
# cargo-lambda is only used for its zig-based cross-compilation here.
#
# Build Azure and GCP functions as static x86_64 Linux binaries under target/lambda/<bin>/bootstrap.
build-musl:
    cargo lambda build --release --target {{musl_target}} $(printf -- '--bin %s ' {{azure_bins}} {{gcp_bins}})

# This is the layout published on releases. Azure zips hold host.json, the bin's
# azure/<function>/function.json folders and the handler binary; GCP tarballs hold the binary
# as ./function, which Cloud Run runs on its OS-only base image.
#
# Package functions into dist/<bin>.zip (AWS, Azure) and dist/<bin>.tar.gz (GCP) with a SHA256SUMS file.
package: build
    #!/usr/bin/env bash
    set -euo pipefail
    rm -rf {{dist}} && mkdir -p {{dist}}
    for bin in {{aws_bins}}; do
      cp "target/lambda/$bin/bootstrap.zip" "{{dist}}/$bin.zip"
    done
    for bin in {{azure_bins}}; do
      stage="target/azure/$bin"
      rm -rf "$stage" && mkdir -p "$stage"
      cp azure/host.json "$stage/"
      # One folder with a function.json per function of the app, e.g. an HTTP and a timer function.
      cp -R "bins/$bin/azure/." "$stage/"
      cp "target/lambda/$bin/bootstrap" "$stage/handler"
      # Fixed timestamps keep the zip, and so its checksum, reproducible.
      find "$stage" -exec touch -t 202001010000 {} +
      (cd "$stage" && zip -qrX "$OLDPWD/{{dist}}/$bin.zip" .)
    done
    for bin in {{gcp_bins}}; do
      # Python's tarfile, with fixed owner, mode and timestamps, gives the same archive on every OS.
      python3 -c 'import gzip, sys, tarfile
    src, dst = sys.argv[1:]
    with open(src, "rb") as f, gzip.GzipFile(dst, "wb", mtime=0) as gz, tarfile.open(fileobj=gz, mode="w") as tar:
        info = tarfile.TarInfo("function")
        info.size, info.mode, info.mtime = f.seek(0, 2), 0o755, 0
        f.seek(0)
        tar.addfile(info, f)' "target/lambda/$bin/bootstrap" "{{dist}}/$bin.tar.gz"
    done
    cd {{dist}} && shasum -a 256 *.zip *.tar.gz > SHA256SUMS
