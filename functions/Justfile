dist := "dist"
musl_target := "x86_64-unknown-linux-musl"

# Functions are grouped by cloud through their bin name suffix, e.g. echo-aws, echo-azure.
aws_bins := `ls bins | grep -- '-aws$' | tr '\n' ' '`
azure_bins := `ls bins | grep -- '-azure$' | tr '\n' ' '`
gcp_bins := `ls bins | grep -- '-gcp$' | tr '\n' ' '`

# Format check, lint and unit tests.
check:
    cargo fmt --check
    cargo clippy --all-targets -- -D warnings
    cargo test

# Build every function.
build: build-aws build-musl

# Build AWS functions as arm64 Lambda zips under target/lambda/<bin>/bootstrap.zip.
build-aws:
    cargo lambda build --release --arm64 --output-format zip $(printf -- '--bin %s ' {{aws_bins}})

# The binaries run in Azure Functions custom handlers and Cloud Run images. cargo-lambda is
# only used for its zig-based cross-compilation here.
#
# Build Azure and GCP functions as static x86_64 Linux binaries under target/lambda/<bin>/bootstrap.
build-musl:
    cargo lambda build --release --target {{musl_target}} $(printf -- '--bin %s ' {{azure_bins}} {{gcp_bins}})

# This is the layout published on releases. Azure zips hold host.json, <function>/function.json
# and the handler binary.
#
# Package AWS and Azure functions into dist/<bin>.zip with a SHA256SUMS file.
package: build
    #!/usr/bin/env bash
    set -euo pipefail
    rm -rf {{dist}} && mkdir -p {{dist}}
    for bin in {{aws_bins}}; do
      cp "target/lambda/$bin/bootstrap.zip" "{{dist}}/$bin.zip"
    done
    for bin in {{azure_bins}}; do
      stage="target/azure/$bin"
      rm -rf "$stage" && mkdir -p "$stage/${bin%-azure}"
      cp azure/host.json "$stage/"
      cp "bins/$bin/function.json" "$stage/${bin%-azure}/"
      cp "target/lambda/$bin/bootstrap" "$stage/handler"
      # Fixed timestamps keep the zip, and so its checksum, reproducible.
      find "$stage" -exec touch -t 202001010000 {} +
      (cd "$stage" && zip -qrX "$OLDPWD/{{dist}}/$bin.zip" .)
    done
    cd {{dist}} && shasum -a 256 *.zip > SHA256SUMS

# Build one Cloud Run image per GCP function, tagged <repository>/<bin>:<tag>.
images repository tag: build-musl
    #!/usr/bin/env bash
    set -euo pipefail
    for bin in {{gcp_bins}}; do
      stage="target/gcp/$bin"
      rm -rf "$stage" && mkdir -p "$stage"
      cp "target/lambda/$bin/bootstrap" "$stage/function"
      docker build --platform linux/amd64 -f gcp/Dockerfile -t "{{repository}}/$bin:{{tag}}" "$stage"
    done

# Push the images built by `images`.
push-images repository tag:
    for bin in {{gcp_bins}}; do docker push "{{repository}}/$bin:{{tag}}"; done
