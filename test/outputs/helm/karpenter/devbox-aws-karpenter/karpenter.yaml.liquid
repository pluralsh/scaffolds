
replicas: 2

settings:
  clusterName: {{ imports[configuration.stackName].cluster_name }}
  clusterEndpoint: {{ imports[configuration.stackName].cluster_endpoint }}
  interruptionQueue: {{ imports[configuration.stackName].interruption_queue }}
  featureGates:
    # Each devbox pool's NodeOverlay tells Karpenter its nodes will have ate.dev/kvm.
    nodeOverlay: true

serviceAccount:
  name: karpenter

controller:
  resources:
    requests:
      cpu: 250m
      memory: 512Mi
    limits:
      memory: 1Gi

