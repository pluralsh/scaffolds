# Agent Substrate for the devboxes on devbox-full-aws-karpenter. Values reference:
# https://github.com/pluralsh/console/blob/master/charts/agent-substrate/values.yaml

# Wires Substrate to the deployment operator's devbox-gateway in plrl-deploy-operator and makes the operator's
# ServiceAccount a bootstrap owner, so it can create atespaces.
devboxes:
  enabled: true

otel:
  endpoint: ""

cloudnative-pg:
  enabled: true

# Substrate workers only run on devbox pools, so atelet only needs to run there too, on every pool of the cluster.
# It doesn't tolerate the plural.sh/devbox-disk startup taint, so it waits for devbox-disk-prep to mount /var/lib/ate.
atelet:
  affinity:
    nodeAffinity:
      requiredDuringSchedulingIgnoredDuringExecution:
        nodeSelectorTerms:
        - matchExpressions:
          - key: plural.sh/devbox-pool
            operator: Exists


# ate-api-server and atelet get their S3 access through EKS Pod Identity associations made by the devbox-nodes stack.
objectStore:
  backend: s3
  snapshotLocation: {{ imports[configuration.stackName].substrate_snapshot_location }}
  s3:
    region: us-east-2


# ZeroFS devbox homes (DevboxRunner spec.home.storage: ZeroFS), kept under devbox-homes-zerofs/ in the snapshot
# bucket through the devbox-zerofs ServiceAccount's own access, which the devbox-nodes stack grants. Its image is a
# deployment-operator release; keep it in step with the operator.
zerofs:
  enabled: true
  image:
    tag: "0.6.77"

  # devbox-zerofs reaches S3 through the EKS Pod Identity association the devbox-nodes stack makes for it.

