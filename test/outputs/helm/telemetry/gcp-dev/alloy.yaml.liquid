cluster:
  name: "{{ cluster.handle }}"

destinations:
  metrics:
    type: prometheus
    url: https://telemetry.plural.sh/metrics/write/ns/default/api/v1/write
    auth:
      type: basic
      username: "{{ configuration.username }}"
      password: "{{ configuration.password }}"

  logs:
    type: loki
    url: https://telemetry.plural.sh/logs/write/ns/default/loki/api/v1/push
    auth:
      type: basic
      username: "{{ configuration.username }}"
      password: "{{ configuration.password }}"

  traces:
    type: otlp
    protocol: http
    url: https://telemetry.plural.sh/traces/write/ns/default
    auth:
      type: basic
      username: "{{ configuration.username }}"
      password: "{{ configuration.password }}"
    metrics:
      enabled: false
    logs:
      enabled: false
    traces:
      enabled: true

clusterMetrics:
  enabled: true
  destinations: [metrics]
  cadvisor:
    metricsTuning:
      # added to the default allowlist for the Console's node, OOM kill and ephemeral storage graphs
      includeMetrics:
      - machine_cpu_cores
      - container_oom_events_total
      - container_fs_usage_bytes

hostMetrics:
  enabled: true
  destinations: [metrics]
  linuxHosts:
    enabled: true
    metricsTuning:
      useIntegrationAllowList: true

annotationAutodiscovery:
  enabled: true
  destinations: [metrics]

# Scrapes ServiceMonitors and PodMonitors when the Prometheus operator CRDs exist.
prometheusOperatorObjects:
  enabled: true
  destinations: [metrics]

clusterEvents:
  enabled: true
  destinations: [logs]

podLogsViaLoki:
  enabled: true
  destinations: [logs]

# OTLP receivers for applications that push their own telemetry.
applicationObservability:
  enabled: true
  destinations: [metrics, logs, traces]
  receivers:
    otlp:
      grpc:
        enabled: true
      http:
        enabled: true

collectors:
  alloy:
    presets:
    - clustered
    - filesystem-log-reader
    - otel-receiver

# The Alloy operator is deployed separately as its own global service.
alloy-operator:
  deploy: false

telemetryServices:
  kube-state-metrics:
    deploy: true
  node-exporter:
    deploy: true
