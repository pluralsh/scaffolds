
global:
  # One object store shared by Metrics, Logs and Traces. Each product keeps its
  # data under its own path (metrics/, logs/, traces/) set by the chart.
  storage:
    objectStore:
{% if configuration.cloud == 'aws' %}
      type: Aws
      aws:
        region: {{ imports[configuration.stackName].region }}
        bucket: {{ imports[configuration.stackName].bucket_name }}
{% elsif configuration.cloud == 'azure' %}
      type: Azure
      # Clears the chart's default AWS block so only one provider is configured.
      aws: null
      azure:
        account: {{ imports[configuration.stackName].storage_account_name }}
        container: {{ imports[configuration.stackName].container_name }}
        workloadIdentity:
          clientID: {{ imports[configuration.stackName].client_id }}
          tenantID: {{ imports[configuration.stackName].tenant_id }}
          tokenFile: /var/run/secrets/azure/tokens/azure-identity-token
{% elsif configuration.cloud == 'gcp' %}
      type: Gcp
      aws: null
      gcp:
        bucket: {{ imports[configuration.stackName].bucket_name }}
{% endif %}
  # One host for everything, routed by path: /metrics, /logs and /traces.
  ingress:
    enabled: true
    hostname: {{ configuration.hostname }}
    ingressClass: {{ configuration.ingressClass }}
    tls:
      enabled: true
      secretName: telemetry-tls

# The password is generated by a GeneratedSecret on mgmt and injected here
# through the service's configurationRef, so it never lives in git or terraform
# state. The chart creates the plrl-telemetry-auth secret on the target cluster.
authSecret:
  create: true
  name: plrl-telemetry-auth
  username: "{{ configuration.username }}"
  password: "{{ configuration.password }}"

{% assign products = "metrics,logs,traces" | split: "," %}
products:
{% for product in products %}
  {{ product }}:
    authentications:
    - name: {{ product }}-authz
      namespace: default
      username: "{{ configuration.username }}"
      permission: write
    spec:
      # The pod annotations make the Alloy agents scrape the stores' own /metrics.
      # Writers are not rolled out with less than 6Gi of memory.
      writer:
        replicas: 1
        resources:
          limits:
            memory: 6Gi
        podTemplate:
          metadata:
            annotations:
              k8s.grafana.com/scrape: "true"
              k8s.grafana.com/metrics.portName: http
{% if configuration.cloud == 'azure' %}
            labels:
              azure.workload.identity/use: "true"
{% endif %}
      reader:
        replicas: 1
{% if product == 'metrics' %}
        resources:
          requests:
            memory: 4Gi
          limits:
            memory: 4Gi
{% endif %}
        podTemplate:
          metadata:
            annotations:
              k8s.grafana.com/scrape: "true"
              k8s.grafana.com/metrics.portName: http
{% if configuration.cloud == 'azure' %}
            labels:
              azure.workload.identity/use: "true"
{% endif %}
{% if configuration.cloud == 'gcp' %}
      serviceAccount:
        annotations:
          iam.gke.io/gcp-service-account: {{ imports[configuration.stackName].service_account_email }}
{% elsif configuration.cloud == 'azure' %}
      serviceAccount:
        annotations:
          azure.workload.identity/client-id: {{ imports[configuration.stackName].client_id }}
{% endif %}
{% if product == 'metrics' %}
      ingress:
        metadata:
          annotations:
            cert-manager.io/cluster-issuer: {{ configuration.clusterIssuer }}
{% endif %}
{% endfor %}

