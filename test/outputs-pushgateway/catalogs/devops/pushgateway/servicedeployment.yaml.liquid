apiVersion: deployments.plural.sh/v1alpha1
kind: ServiceDeployment
metadata:
  name: pushgateway-{{ context.cluster }}
  namespace: apps
spec:
{% if context.ai %}
  agentId: {{ context.ai.session.agent_id }}
{% endif %}
  name: pushgateway
  namespace: pushgateway
  git:
    ref: main
    folder: helm/pushgateway/{{ context.cluster }}
  repositoryRef:
    kind: GitRepository
    name: infra
    namespace: infra
  helm:
    chart: prometheus-pushgateway
    version: "3.8.0"
    release: pushgateway
    url: https://prometheus-community.github.io/helm-charts
    valuesFiles:
    - values.yaml
  cluster: {{ context.cluster | quote }}
