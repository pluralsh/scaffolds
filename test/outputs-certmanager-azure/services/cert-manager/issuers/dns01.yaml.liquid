apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: dns01
spec:
  acme:
    server: https://acme-v02.api.letsencrypt.org/directory
    email: "certificates@example.org"
    privateKeySecretRef:
      name: dns01-private-key
    solvers:
    - dns01:

        azureDNS:
          hostedZoneName: "example.org"
          resourceGroupName: "dns-resource-group"
          subscriptionID: {{ cluster.metadata.subscription_id }}
          managedIdentity:
            clientID: {{ cluster.metadata.iam.cert_manager }}
          environment: AzurePublicCloud
